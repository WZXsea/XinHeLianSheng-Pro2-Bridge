<!-- Modified in the enhanced fork (2026-10); see docs/LOCAL_CHANGES.md. -->
<Window x:Class="Y700Switch2V60Viiper.BluetoothRestartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Y700Switch2V60Viiper" local:NeonWindowChrome.Enabled="True"
        Title="重启蓝牙适配器" Width="680" Height="480" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#0D1425" FontFamily="Microsoft YaHei UI" FontSize="14"
        Foreground="#E7EEFF" ResizeMode="CanResize" ShowInTaskbar="False">
    <Window.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="NeonTheme.xaml"/></ResourceDictionary.MergedDictionaries>
        <Style TargetType="Button" BasedOn="{StaticResource NeonButton}">
            <Setter Property="Padding" Value="18,10"/><Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#172136"/><Setter Property="Foreground" Value="#9ADCCE"/>
            <Setter Property="BorderBrush" Value="#354460"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </ResourceDictionary></Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="重启蓝牙适配器" FontSize="25" FontWeight="SemiBold" Foreground="#9ADCCE"/>
            <TextBlock Text="仅重启所选设备，不改蓝牙参数、驱动或配对。" Foreground="#95A5C1" TextWrapping="Wrap" Margin="0,8,0,20"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <TextBlock Text="选择适配器" Foreground="#9ADCCE" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ComboBox x:Name="AdapterPicker" ItemsSource="{Binding}" SelectionChanged="AdapterPicker_SelectionChanged" Padding="10,8">
                <ComboBox.ItemTemplate><DataTemplate>
                    <StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding DriverSummary}" FontSize="12" Foreground="#95A5C1" Margin="0,4,0,0"/>
                    </StackPanel>
                </DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock x:Name="SelectedDeviceText" TextWrapping="Wrap" FontSize="12" Foreground="#95A5C1" Margin="0,8,0,0"/>
        </StackPanel>
        <Border Grid.Row="2" Background="#30291F" BorderBrush="#75603A" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,18,0,18" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="蓝牙连接会暂时断开" FontWeight="SemiBold" Foreground="#E2C28C"/>
                <TextBlock Text="将停止助手的手柄连接和游戏输出。所选适配器上的蓝牙耳机、鼠标、键盘等也会断开；请先保存游戏。" TextWrapping="Wrap" Foreground="#E2C28C" Margin="0,8,0,0"/>
                <TextBlock Text="需要管理员授权。重启后请唤醒 Pro2 并重新连接；此操作不保证提高回报率。" TextWrapping="Wrap" Foreground="#E2C28C" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True"/>
            <Button x:Name="ConfirmButton" Content="重启所选适配器" Click="Confirm_Click" IsEnabled="False" Background="#294950" Foreground="#DAF6F0"/>
        </StackPanel>
    </Grid>
</Window>
