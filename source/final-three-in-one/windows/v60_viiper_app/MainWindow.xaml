<!-- Modified in the enhanced fork (2026-10); see docs/LOCAL_CHANGES.md. -->
<Window x:Class="Y700Switch2V60Viiper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Y700Switch2V60Viiper"
        Title="PRO2 手柄助手" Width="1040" Height="820" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#080C17"
        Foreground="#E7EEFF" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="NeonTheme.xaml"/></ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <SolidColorBrush x:Key="Muted" Color="#95A5C1"/>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontWeight" Value="Normal"/></Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource NeonButton}"/>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource NeonPrimary}"/>
            <Setter Property="BorderBrush" Value="#89DBE0"/>
            <Setter Property="Foreground" Value="#0B2430"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#D0121B2D"/>
            <Setter Property="BorderBrush" Value="{StaticResource NeonEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="ModeCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="18,20"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="#9CAEC9"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                        <StackPanel><ContentPresenter ContentSource="Header"/><Border x:Name="TabAccent" Height="2" Margin="0,6,0,-5" Background="{StaticResource NeonSpectrum}" Opacity="0"/></StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="#E2E5FF"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="TabBorder" Property="Background" Value="#20263F"/><Setter TargetName="TabAccent" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="#468872"/><Setter TargetName="TabBorder" Property="BorderThickness" Value="1"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource NeonCheckBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource NeonComboBox}"/>
        <Style x:Key="HomeCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#91A4BC"/><Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="HomeMetric" TargetType="Border">
            <Setter Property="Background" Value="#C0192439"/><Setter Property="BorderBrush" Value="#2B3B52"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/><Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="HomeAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1B2A40"/><Setter Property="BorderBrush" Value="#35465E"/>
            <Setter Property="Foreground" Value="#E5EDF9"/><Setter Property="Padding" Value="14,10"/>
        </Style>
        <Style x:Key="HomeConnect" TargetType="Button" BasedOn="{StaticResource HomeAction}">
            <Setter Property="Background" Value="#75E6C4"/><Setter Property="BorderBrush" Value="#75E6C4"/>
            <Setter Property="Foreground" Value="#102B2B"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#A0F3D9"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".8"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Background" Value="#24453F"/><Setter TargetName="Surface" Property="BorderBrush" Value="#365C51"/><Setter Property="Foreground" Value="#B2DDCC"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="HomeMode" TargetType="Button" BasedOn="{StaticResource HomeAction}">
            <Setter Property="Padding" Value="8,0"/><Setter Property="Margin" Value="2"/>
            <Setter Property="Foreground" Value="#8FA2BC"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" CornerRadius="9" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#0EFFFFFF"/><Setter Property="Foreground" Value="#EDF5FF"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".65"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".45"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A2ECD6"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Foreground" Value="#B2FFE3"/></DataTrigger></Style.Triggers>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
    <local:NeonAmbience x:Name="WindowAmbience"/>
    <Grid Margin="22,16,22,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#1C293C" BorderBrush="{StaticResource NeonSpectrum}" BorderThickness="1" CornerRadius="10" Width="36" Height="36" Margin="0,0,12,0">
                    <TextBlock Text="P" Foreground="White" FontWeight="Bold" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="PRO2 手柄助手" FontWeight="SemiBold" FontSize="19" VerticalAlignment="Center"/>
            </StackPanel>
            <Border Grid.Column="1" CornerRadius="16" Background="#162734" BorderBrush="#335668" BorderThickness="1" Padding="13,7" VerticalAlignment="Center">
                <StackPanel ToolTip="{Binding ActiveInputTransportHint}">
                    <TextBlock x:Name="ActiveInputTransportText" Text="{Binding ActiveInputTransportText}" FontSize="12" Foreground="#9CE9DA" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CompactStateText}" FontSize="10" Foreground="#8EB9BD" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0,12,0,0">
            <TabItem Header="手柄" AutomationProperties.Name="手柄">
                <Border x:Name="HomeDashboard" CornerRadius="18" BorderBrush="{StaticResource NeonEdge}" BorderThickness="1" Padding="20,16"
                        TextElement.Foreground="#E9F0FA" SizeChanged="HomeDashboard_SizeChanged" Loaded="HomeDashboard_Loaded">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#CC111B2E"/><GradientStop Color="#CC1A1B35" Offset="1"/></LinearGradientBrush></Border.Background>
                    <Grid x:Name="HomeDashboardContent">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <ScrollViewer x:Name="HomeScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="HomeModelColumn" Width="280"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Width="4" CornerRadius="2" Background="#75E6C4" Margin="0,0,8,0"/>
                                            <TextBlock Text="NS2 PRO  /  连接状态" FontSize="11" Foreground="#83E9CC" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock x:Name="BleConnectionTitleText" Text="{Binding BleConnectionTitle}" FontSize="28" FontWeight="SemiBold" Foreground="#F2F6FC"/>
                                        <TextBlock x:Name="BleConnectionHintText" Text="{Binding HomeConnectionHint}" Foreground="#9CADC2" FontSize="12" Margin="0,9,0,0" LineHeight="19"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" IsHitTestVisible="False">
                                        <Grid.Style><Style TargetType="Grid"><Setter Property="Height" Value="158"/><Style.Triggers>
                                            <DataTrigger Binding="{Binding HasLowRateWarning}" Value="True"><Setter Property="Height" Value="90"/></DataTrigger>
                                            <DataTrigger Binding="{Binding ShowWin10BleHomePanel}" Value="True"><Setter Property="Height" Value="90"/></DataTrigger>
                                        </Style.Triggers></Style></Grid.Style>
                                        <Ellipse Width="190" Height="110" VerticalAlignment="Center" Opacity=".12"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#65C6AF"/><GradientStop Color="#0065C6AF" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
                                        <local:HomeControllerPreview/>
                                    </Grid>
                                </Grid>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource HomeMetric}">
                                        <StackPanel><TextBlock Text="输入回报率" Style="{StaticResource HomeCaption}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock Text="{Binding CompactInputRate}" FontSize="27" Foreground="#EDF5FF" FontWeight="SemiBold"/><TextBlock Text=" Hz" FontSize="12" Foreground="#8DA5BF" VerticalAlignment="Bottom" Margin="0,0,0,4"/></StackPanel>
                                            <TextBlock Text="{Binding HomeInputSummary}" Style="{StaticResource HomeCaption}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource HomeMetric}">
                                        <StackPanel><TextBlock Text="电源 / 电量" Style="{StaticResource HomeCaption}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Border BorderBrush="#70978A" BorderThickness="1" CornerRadius="3" Padding="2" VerticalAlignment="Center">
                                                    <ItemsControl ItemsSource="{Binding CompactBatteryVisual.Segments}" AutomationProperties.Name="手柄电量档位">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate><DataTemplate><Border Width="5" Height="13" CornerRadius="1" Background="{Binding Fill}" Margin="0,0,2,0"/></DataTemplate></ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                                <Border Width="3" Height="8" CornerRadius="0,2,2,0" Background="#70978A" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Text="{Binding CompactBatteryVisual.Level}" FontSize="16" FontWeight="SemiBold" Foreground="#E9F0FA" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding HomeBatteryStatus}" FontSize="11" Foreground="#86D9BE" Margin="0,7,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource HomeMetric}" Margin="0">
                                        <StackPanel><TextBlock Text="当前输出" Style="{StaticResource HomeCaption}"/>
                                            <TextBlock Text="{Binding HomeOutputLabel}" Foreground="#EDF5FF" FontSize="20" FontWeight="SemiBold" Margin="0,9,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding CompactHeadset, StringFormat=耳机孔 · {0}}" Style="{StaticResource HomeCaption}" Margin="0,7,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border x:Name="LowRateNotice" Visibility="{Binding HasLowRateWarning, Converter={StaticResource BoolVisibility}}"
                                        Background="#302A21" BorderBrush="#7B643F" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,14">
                                    <StackPanel><TextBlock Text="{Binding LowRateTitle}" Foreground="#E8C48B" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding HomeLowRateHint}" Foreground="#C6AB83" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="游戏输出" FontSize="13" FontWeight="SemiBold" Foreground="#DCE7F7" Margin="0,0,0,10"/>
                                <Border Background="#0C1626" BorderBrush="#2A3A50" BorderThickness="1" CornerRadius="14" Padding="4">
                                    <Grid x:Name="HomeModeRail" Height="62" SizeChanged="HomeModeRail_SizeChanged" IsEnabled="{Binding CanOperate}">
                                        <Canvas IsHitTestVisible="False">
                                            <Border x:Name="ActiveModePill" Height="58" CornerRadius="10" BorderBrush="#528C7D" BorderThickness="1" Canvas.Top="2">
                                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#2B514E"/><GradientStop Color="#1C363C" Offset="1"/></LinearGradientBrush></Border.Background>
                                                <Border.RenderTransform><TranslateTransform x:Name="HomeModePillTransform"/></Border.RenderTransform>
                                                <Rectangle Height="2" Width="24" RadiusX="1" RadiusY="1" Fill="#82EDCB" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                                            </Border>
                                        </Canvas>
                                        <UniformGrid Columns="4">
                                            <Button Style="{StaticResource HomeMode}" Tag="{Binding IsPro2Selected}" Command="{Binding SelectCompactModeCommand}" CommandParameter="Pro2" AutomationProperties.Name="Steam / Pro2 模式">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="21" Height="21" Margin="0,0,9,0"><Canvas Width="24" Height="24"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeLineJoin="Round" Data="M4,16 L9,18 L16,10 M5,12 L10,14 L14,8"/><Ellipse Width="9" Height="9" Canvas.Left="12" Canvas.Top="3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7"/><Ellipse Width="6" Height="6" Canvas.Left="4" Canvas.Top="13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7"/></Canvas></Viewbox>
                                                    <TextBlock Text="Steam / Pro2" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource HomeMode}" Tag="{Binding IsPro1Selected}" Command="{Binding SelectCompactModeCommand}" CommandParameter="Pro1" AutomationProperties.Name="Pro1 模式">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="21" Height="21" Margin="0,0,9,0"><Canvas Width="24" Height="24"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Data="M10,3 L7,3 Q3,3 3,7 L3,17 Q3,21 7,21 L10,21 Z M14,3 L17,3 Q21,3 21,7 L21,17 Q21,21 17,21 L14,21 Z"/><Ellipse Width="4" Height="4" Canvas.Left="5" Canvas.Top="6" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><Ellipse Width="4" Height="4" Canvas.Left="15" Canvas.Top="13" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Canvas></Viewbox>
                                                    <TextBlock Text="Pro1" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource HomeMode}" Tag="{Binding IsXboxSelected}" Command="{Binding SelectCompactModeCommand}" CommandParameter="Xbox" AutomationProperties.Name="Xbox 模式">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="21" Height="21" Margin="0,0,9,0"><Canvas Width="24" Height="24"><Ellipse Width="21" Height="21" Canvas.Left="1.5" Canvas.Top="1.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M6,5 Q12,9 18,19 M18,5 Q12,9 6,19"/></Canvas></Viewbox>
                                                    <TextBlock Text="Xbox" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource HomeMode}" Tag="{Binding CompactPs5Selected}" Command="{Binding SelectCompactModeCommand}" CommandParameter="PS5" AutomationProperties.Name="PS5 模式">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="23" Height="21" Margin="0,0,9,0"><Canvas Width="26" Height="24"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeLineJoin="Round" Data="M8,5 Q4,4 3,8 L1,17 Q1,21 4,20 L9,16 L17,16 L22,20 Q25,21 25,17 L23,8 Q22,4 18,5 Z M7,8 L7,14 M4,11 L10,11 M18,9 L18,10 M21,12 L21,13"/></Canvas></Viewbox>
                                                    <TextBlock Text="PS5" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="HomeModeDescriptionText" Text="{Binding HomeModeDescription}" Foreground="#90A7C2" FontSize="11" Margin="3,10,0,10"/>
                                <Expander Header="连接选项" Foreground="#91A4BC" FontSize="11" Margin="0,2,0,0">
                                    <StackPanel Margin="0,8,0,8">
                                        <Button Content="手动连接" Click="ManualConnect_Click" Style="{StaticResource HomeAction}" IsEnabled="{Binding CanOperate}" HorizontalAlignment="Left" FontSize="12" ToolTip="自动连接失败时，手动选择设备"/>

                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <WrapPanel>
                                <Button Content="{Binding CompactConnectText}" Command="{Binding ConnectPro2InputCommand}" Style="{StaticResource HomeConnect}" IsEnabled="{Binding CompactCanConnect}" MinWidth="145"/>
                                <Button Content="停止 / 暂停重连" Command="{Binding CompactStopCommand}" Style="{StaticResource HomeAction}" IsEnabled="{Binding CompactCanStop}"/>
                                <Button Content="按键配置 →" Click="OpenConfigurationCenter_Click" Style="{StaticResource HomeAction}"/>
                                <Button x:Name="Win10BleOptimizeButton" Content="优化蓝牙 · Win10" Click="ToggleWin10BleHomePanel_Click" Style="{StaticResource HomeAction}"
                                        IsEnabled="{Binding CanOperate}" Visibility="{Binding ShowWin10BleHomeAction, Converter={StaticResource BoolVisibility}}" ToolTip="选择 7.5ms 参数并授权测试"/>
                                <Button Content="取消操作" Command="{Binding CancelConnectionCommand}" Style="{StaticResource HomeAction}" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}"/>
                            </WrapPanel>
                        <Border x:Name="Win10BleHomePanel" Visibility="{Binding ShowWin10BleHomePanel, Converter={StaticResource BoolVisibility}}"
                                Background="#1B2B3D" BorderBrush="#35485F" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,4,4,0">
                            <StackPanel IsEnabled="{Binding CanOperate}">
                                <TextBlock Text="Win10 蓝牙优化" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Win10BleHomeHint}" Style="{StaticResource HomeCaption}" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <ComboBox x:Name="Win10BlePresetComboBox" Width="145" ItemsSource="{Binding Win10BlePresetOptions}" SelectedItem="{Binding SelectedWin10BlePreset}"
                                              DisplayMemberPath="Title" Margin="0,0,8,0" IsEnabled="{Binding CanConfigureWin10Stack}"
                                              ToolTip="固定 7.5ms 优先；其他两组用于兼容尝试"/>
                                    <Button x:Name="Win10BleConfigureButton" Content="授权并测试" Click="ConfigureBleTurbo_Click" Margin="0,0,8,0" Padding="14,7"
                                            IsEnabled="{Binding CanConfigureWin10Stack}" ToolTip="{Binding Win10BlePresetSafetyNote}"/>
                                    <Button x:Name="BleRestoreParametersButton" Content="恢复原参数" Click="RestoreBleTurbo_Click" Margin="0" Padding="14,7"/>
                                </WrapPanel>
                                <TextBlock Text="效果以真实输入为准；未提速时，可换预设或恢复原参数。" Style="{StaticResource HomeCaption}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="{Binding HomeSessionSummary}" Foreground="#90A4BD" FontSize="11" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="震动" AutomationProperties.Name="震动" Unloaded="RumblePage_Unloaded">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Unloaded="RumblePage_Unloaded">
                    <StackPanel Margin="0,0,4,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel><TextBlock Text="{Binding RumblePercentText}" DockPanel.Dock="Right" FontWeight="SemiBold"/><TextBlock Text="震动强度" FontSize="23" FontWeight="SemiBold"/></DockPanel>
                                <Slider x:Name="RumbleStrengthSlider" Minimum="0" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True"
                                        Value="{Binding RumblePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,18,0,4" AutomationProperties.Name="震动强度"
                                        ValueChanged="RumbleSlider_ValueChanged" PreviewMouseLeftButtonDown="RumbleSlider_MouseDown" PreviewMouseLeftButtonUp="RumbleSlider_MouseUp"
                                        LostMouseCapture="RumbleSlider_LostCapture" PreviewKeyDown="RumbleSlider_KeyDown"/>
                                <DockPanel Margin="8,0,8,12"><TextBlock Text="300%" DockPanel.Dock="Right" Style="{StaticResource MutedText}"/><TextBlock Text="0% · 关闭" Style="{StaticResource MutedText}"/></DockPanel>
                                <DockPanel><Button Content="试振" Command="{Binding PreviewRumbleCommand}" IsEnabled="{Binding CanPreviewRumble}" DockPanel.Dock="Right" Margin="12,0,0,0" Padding="18,8"/>
                                    <TextBlock Text="{Binding RumblePreviewHint}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="游戏反馈" Style="{StaticResource MutedText}" Margin="0,16,0,0"/>
                                <TextBlock Text="{Binding CompactHapticSource}" FontSize="15" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="ControllerTestTab" Header="配置中心" AutomationProperties.Name="手柄测试与按键配置中心">
                <local:ControllerTestView x:Name="ControllerTester"/>
            </TabItem>
            <TabItem Header="设置" AutomationProperties.Name="设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,4,0">
                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="USBIP" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding UsbipLocationText}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding RuntimeReadinessText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,4"/>
                                <WrapPanel IsEnabled="{Binding CanManageRuntime}">
                                    <Button x:Name="SelectUsbipPathButton" Content="选择 usbip.exe…" Click="SelectUsbipPath_Click"/>
                                    <Button x:Name="ResetUsbipPathButton" Content="自动查找" Command="{Binding ResetUsbipPathCommand}"/>
                                    <Button Content="安装 / 修复驱动" Command="{Binding InstallUsbipCommand}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <Button x:Name="SettingsEnvironmentInfoButton" Content="系统与蓝牙信息…" Click="EnvironmentInfo_Click" DockPanel.Dock="Right" Padding="12,6" Margin="0"/>
                                    <ComboBox x:Name="InputTransportSelector" DockPanel.Dock="Right" Width="190" Margin="0,0,12,0"
                                              ItemsSource="{Binding InputTransportOptions}" SelectedItem="{Binding SelectedInputTransport}"
                                              IsEnabled="{Binding CanManageRuntime}" AutomationProperties.Name="手柄连接方式"
                                              ToolTip="下次连接生效。切换前请先停止连接；自动模式优先使用数据线。"/>
                                    <TextBlock Text="设置" FontSize="23" FontWeight="SemiBold"/>
                                </DockPanel>
                                <WrapPanel>
                                    <CheckBox Content="登录 Windows 时自动启动" IsChecked="{Binding LaunchAtLoginEnabled}" Margin="0,0,28,12"/>
                                    <CheckBox Content="启动后自动进入上次使用的模式" IsChecked="{Binding AutoReconnectOnStartupEnabled}"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <CheckBox Content="定期更新电量" IsChecked="{Binding RuntimeBatteryRefreshEnabled}"
                                              Margin="0,0,28,0" ToolTip="USB 约每5分钟在连续空闲5秒后短暂采样，蓝牙约每10分钟更新。操作时延后，异常时暂停并保留上次读取值。"/>
                                    <CheckBox x:Name="AutoOptimizeBleCheckBox" Content="低速时自动优化蓝牙" IsChecked="{Binding AutoOptimizeBle}" IsEnabled="{Binding CanChangeBleOptimizationSettings}"
                                              ToolTip="Win11 在当前连接内自动尝试有限预设，跨适配器型号和驱动版本开放；Win10 全局参数必须单独确认和管理员授权，不会静默轮换。"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel IsEnabled="{Binding CanOperate}">
                                <TextBlock Text="校准与连接" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button Content="摇杆零位校准" Command="{Binding CalibrateStickCenterSlotCommand}" CommandParameter="1"/>
                                    <Button Content="摇杆行程校准" Command="{Binding CalibrateStickRangeSlotCommand}" CommandParameter="1"/>
                                    <Button Content="陀螺仪校准" Command="{Binding CalibrateSourceGyroCommand}"/>
                                    <Button Content="断开真实手柄" Command="{Binding DisconnectPro2InputCommand}"/>
                                    <Button x:Name="RestartBluetoothAdapterButton" Content="重启蓝牙适配器…" Click="RestartBluetooth_Click"
                                            ToolTip="需要管理员授权；所选适配器的蓝牙连接会暂时断开，不改驱动或配对。"/>
                                </WrapPanel>
                                <TextBlock Text="零位：松开摇杆2秒 · 行程：沿外圈转动8秒 · 陀螺仪：静置3秒" Style="{StaticResource MutedText}"/>
                                <TextBlock Text="{Binding BluetoothRestartStatus}" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,8,0,0"
                                           Visibility="{Binding HasBluetoothRestartStatus, Converter={StaticResource BoolVisibility}}"/>
                                <Expander Header="更多手柄 · Steam / Xbox" Margin="0,16,0,0">
                                    <ItemsControl ItemsSource="{Binding Pro2Slots}">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <StackPanel Margin="0,12,0,8">
                                                <DockPanel>
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}" DockPanel.Dock="Left" Margin="0,0,16,0"/>
                                                    <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}"/>
                                                </DockPanel>
                                                <WrapPanel Margin="0,6,0,0">
                                                    <Button Content="连接" Command="{Binding DataContext.ConnectPro2SlotCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Index}"/>
                                                    <Button Content="断开" Command="{Binding DataContext.DisconnectPro2SlotCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Index}"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </StackPanel>
                        </Border>
                        <Expander Header="高级设置与诊断" IsExpanded="{Binding ShowDiagnostics}" Padding="0,4">
                            <StackPanel>
                        <Border x:Name="LowRateDiagnosticPanel" Visibility="{Binding HasLowRateWarning, Converter={StaticResource BoolVisibility}}"
                                Background="#302A21" BorderBrush="#7B643F" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding LowRateTitle}" Foreground="#E8C48B" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="BleOptimizationSummaryText" Text="{Binding BleOptimizationSummary}" Visibility="{Binding ShowBleOptimizationSummary, Converter={StaticResource BoolVisibility}}"
                                           Foreground="#E8C48B" FontSize="12" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding LowRateMeasuredSummary}" Foreground="#E8C48B" FontSize="12" Margin="0,4,0,0"/>
                                <Expander Header="原因待定位 · 依据、建议与导出" FontSize="12" Foreground="#C6AB83" Margin="0,6,0,0">
                                    <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="{Binding LowRateEnvironmentSummary}" Foreground="#C6AB83" FontSize="11" Margin="0,3,0,0"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding EnvironmentHomeSummaryHint}"/>
                                <TextBlock Text="{Binding LowRateSummary}" Foreground="#C6AB83" FontSize="12" Margin="0,5,0,0"/>

                                        <TextBlock Text="{Binding LowRateAdvice}" Foreground="#C6AB83" FontSize="12"/>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="复制诊断" Click="CopyLowRateDiagnosis_Click" Padding="10,5" Margin="0,0,8,4" FontSize="12"/>
                                            <Button Content="信息 / 导出…" Click="EnvironmentInfo_Click" Padding="10,5" Margin="0,0,8,4" FontSize="12"/>
                                            <Button x:Name="BleAutoOptimizeButton" Content="自动优化蓝牙…" Click="TryWin11Compatibility_Click" Padding="10,5" Margin="0,0,8,4" FontSize="12"
                                                    IsEnabled="{Binding CanTryWin11Compatibility}" Visibility="{Binding ShowWin11CompatibilityAction, Converter={StaticResource BoolVisibility}}"/>
                                        </WrapPanel>
                                        <TextBox Text="{Binding LowRateEvidence, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="140"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0"
                                                 BorderThickness="0" Background="Transparent" Foreground="#D8C49F" FontSize="11"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                                <Border Style="{StaticResource Card}" Margin="0,12,0,12">
                                    <StackPanel>
                                        <TextBlock Text="连接信息" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,14"/>
                                        <TextBlock Text="{Binding CompactFirmware, StringFormat=手柄固件：{0}}" ToolTip="{Binding CompactFirmwareHint}" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding CompactBatteryVisual.Caption}" ToolTip="{Binding CompactBatteryHint}" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding BleStabilitySummary}" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
                                        <TextBlock Text="{Binding CompatibilityTitle}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding CompatibilityGuidance}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                                        <TextBlock Text="最小化后仍在托盘运行；窗口刷新不会影响手柄输入。" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
                                        <TextBlock Text="{Binding CompactActualMode}"/>
                                        <TextBlock Text="{Binding InputStatus}" Style="{StaticResource MutedText}" Margin="0,8,0,8"/>
                                        <WrapPanel>
                                            <TextBlock Text="Raw: " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding CompactRawRate}" Margin="0,0,20,0"/>
                                            <TextBlock Text="Parsed: " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding CompactParsedRate}" Margin="0,0,20,0"/>
                                            <TextBlock Text="最新输入年龄: " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding CompactInputAge}"/>
                                        </WrapPanel>
                                        <TextBlock Text="摇杆处理" Margin="0,18,0,0"/>
                                        <ComboBox ItemsSource="{Binding StickProcessingChoices}" SelectedItem="{Binding SelectedStickProcessing}" IsEnabled="{Binding CanOperate}"/>
                                        <TextBlock Text="PS5 陀螺仪倍率"/>
                                        <Slider Minimum="0.1" Maximum="3" Value="{Binding Ps5GyroScale}" Margin="0,12,0,8"/>
                                        <TextBlock Text="{Binding Ps5GyroScaleText}" Style="{StaticResource MutedText}"/>
                                        <WrapPanel IsEnabled="{Binding CanOperate}">
                                            <Button Content="导出诊断包" Command="{Binding ExportDiagnosticsLogCommand}"/>
                                            <Button Content="BLE 实测 15 秒" Command="{Binding RunWin10BleDiagnosticCommand}"/>
                                            <Button Content="清理残留虚拟设备" Command="{Binding CleanupStaleVirtualDevicesCommand}"/>
                                            <Button Content="修复 USBIP 驱动" Command="{Binding InstallUsbipCommand}"/>
                                            <Button Content="刷新 Steam 缓存" Click="RefreshSteamControllerCache_Click"/>
                                        </WrapPanel>
                                        <TextBlock Text="BLE 初始化对照" FontWeight="SemiBold" Margin="0,14,0,6"/>
                                        <CheckBox Content="同时跳过 USB 初始化（对照测试）" IsChecked="{Binding SkipUsbBleInitialization}"/>
                                        <TextBlock Text="默认已跳过配对提交。此开关仅影响下一次连接，不自动断开；本次程序关闭后复位。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel><Button Content="清空显示" DockPanel.Dock="Right" Command="{Binding ClearLogCommand}"/><TextBlock Text="会话日志" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                                        <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Height="180" FontFamily="Consolas" FontSize="11"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#0C1424" Foreground="#B7C6DF" BorderThickness="0" Padding="12"/>
                                        <TextBlock Text="界面日志每秒最多刷新一次；文件日志在后台异步保存。" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
        <DockPanel Grid.Row="2" Margin="0,18,0,0">
            <Button x:Name="FooterEnvironmentInfoButton" DockPanel.Dock="Right" Click="EnvironmentInfo_Click" Padding="5,2" Margin="0"
                    Background="Transparent" BorderBrush="Transparent" FontSize="12" Foreground="{StaticResource Muted}"
                    ToolTip="版本与设备信息">
                <TextBlock Text="v1.3.22"/>
            </Button>
            <TextBlock Text="纯软件 · 无需外置接收器" Style="{StaticResource MutedText}"/>
        </DockPanel>
    </Grid>
    </Grid>
</Window>
