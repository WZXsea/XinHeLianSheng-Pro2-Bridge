<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Pro2.Desktop.Controls" x:Class="Pro2.Desktop.Views.HomeView" x:CompileBindings="False">
<Border CornerRadius="18" BorderBrush="{StaticResource NeonEdge}" BorderThickness="1" Padding="20,16">
                    <Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Color="#CC111B2E" /><GradientStop Color="#CC1A1B35" Offset="1" /></LinearGradientBrush></Border.Background>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Width="4" CornerRadius="2" Background="#75E6C4" Margin="0,0,8,0" />
                                            <TextBlock Text="NS2 PRO  /  连接状态" FontSize="11" Foreground="#83E9CC" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding BleConnectionTitle}" FontSize="28" FontWeight="SemiBold" Foreground="#F2F6FC" />
                                        <TextBlock Text="{Binding HomeConnectionHint}" Foreground="#9CADC2" FontSize="12" Margin="0,9,0,0" LineHeight="19" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" IsHitTestVisible="False">
                                        <Ellipse Width="190" Height="110" VerticalAlignment="Center" Opacity=".12"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#65C6AF" /><GradientStop Color="#0065C6AF" Offset="1" /></RadialGradientBrush></Ellipse.Fill></Ellipse>
                                        <controls:ControllerPreview />
                                    </Grid>
                                </Grid>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Border Classes="home-metric">
                                        <StackPanel><TextBlock Text="输入回报率" Classes="caption" />
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock Text="{Binding CompactInputRate}" FontSize="27" Foreground="#EDF5FF" FontWeight="SemiBold" /><TextBlock Text=" Hz" FontSize="12" Foreground="#8DA5BF" VerticalAlignment="Bottom" Margin="0,0,0,4" /></StackPanel>
                                            <TextBlock Text="{Binding HomeInputSummary}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Classes="caption" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Classes="home-metric">
                                        <StackPanel><TextBlock Text="电源 / 电量" Classes="caption" />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Border BorderBrush="#70978A" BorderThickness="1" CornerRadius="3" Padding="2" VerticalAlignment="Center">
                                                    <ItemsControl ItemsSource="{Binding CompactBatteryVisual.Segments}" AutomationProperties.Name="手柄电量档位">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate><DataTemplate><Border Width="5" Height="13" CornerRadius="1" Background="{Binding Fill}" Margin="0,0,2,0" /></DataTemplate></ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                                <Border Width="3" Height="8" CornerRadius="0,2,2,0" Background="#70978A" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock Text="{Binding CompactBatteryVisual.Level}" FontSize="16" FontWeight="SemiBold" Foreground="#E9F0FA" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding HomeBatteryStatus}" FontSize="11" Foreground="#86D9BE" Margin="0,7,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Margin="0" Classes="home-metric">
                                        <StackPanel><TextBlock Text="当前输出" Classes="caption" />
                                            <TextBlock Text="{Binding HomeOutputLabel}" Foreground="#EDF5FF" FontSize="20" FontWeight="SemiBold" Margin="0,9,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding CompactHeadset, StringFormat=耳机孔 · {0}}" Margin="0,7,0,0" Classes="caption" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Background="#302A21" BorderBrush="#7B643F" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,14" IsVisible="{Binding HasLowRateWarning}">
                                    <StackPanel><TextBlock Text="{Binding LowRateTitle}" Foreground="#E8C48B" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding HomeLowRateHint}" Foreground="#C6AB83" FontSize="11" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="游戏输出" FontSize="13" FontWeight="SemiBold" Foreground="#DCE7F7" Margin="0,0,0,10" />
                                <Border Background="#0C1626" BorderBrush="#2A3A50" BorderThickness="1" CornerRadius="14" Padding="4">
                                    <Grid Height="62" IsEnabled="{Binding CanOperate}">
                                        <UniformGrid Columns="4">
                                            <Button Tag="{Binding IsPro2Selected}" Command="{Binding SelectCompactModeCommand}" CommandParameter="Pro2" AutomationProperties.Name="Steam / Pro2 模式" Classes="home-mode" Classes.selected="{Binding IsPro2Selected}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="21" Height="21" Margin="0,0,9,0"><Canvas Width="24" Height="24"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Data="M4,16 L9,18 L16,10 M5,12 L10,14 L14,8" /><Ellipse Width="9" Height="9" Canvas.Left="12" Canvas.Top="3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" /><Ellipse Width="6" Height="6" Canvas.Left="4" Canvas.Top="13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" /></Canvas></Viewbox>
                                                    <TextBlock Text="Steam / Pro2" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                </StackPanel>
                                            </Button>
                                            <Button Tag="{Binding IsPro1Selected}" Command="{Binding SelectCompactModeCommand}" CommandParameter="Pro1" AutomationProperties.Name="Pro1 模式" Classes="home-mode" Classes.selected="{Binding IsPro1Selected}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="21" Height="21" Margin="0,0,9,0"><Canvas Width="24" Height="24"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Data="M10,3 L7,3 Q3,3 3,7 L3,17 Q3,21 7,21 L10,21 Z M14,3 L17,3 Q21,3 21,7 L21,17 Q21,21 17,21 L14,21 Z" /><Ellipse Width="4" Height="4" Canvas.Left="5" Canvas.Top="6" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /><Ellipse Width="4" Height="4" Canvas.Left="15" Canvas.Top="13" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Canvas></Viewbox>
                                                    <TextBlock Text="Pro1" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Tag="{Binding IsXboxSelected}" Command="{Binding SelectCompactModeCommand}" CommandParameter="Xbox" AutomationProperties.Name="Xbox 模式" Classes="home-mode" Classes.selected="{Binding IsXboxSelected}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="21" Height="21" Margin="0,0,9,0"><Canvas Width="24" Height="24"><Ellipse Width="21" Height="21" Canvas.Left="1.5" Canvas.Top="1.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" /><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.1" Data="M6,5 Q12,9 18,19 M18,5 Q12,9 6,19" /></Canvas></Viewbox>
                                                    <TextBlock Text="Xbox" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes.selected="{Binding CompactPs5Selected}" Tag="{Binding CompactPs5Selected}" Command="{Binding SelectCompactModeCommand}" CommandParameter="PS5" AutomationProperties.Name="PS5 模式" Classes="home-mode">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="23" Height="21" Margin="0,0,9,0"><Canvas Width="26" Height="24"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Data="M8,5 Q4,4 3,8 L1,17 Q1,21 4,20 L9,16 L17,16 L22,20 Q25,21 25,17 L23,8 Q22,4 18,5 Z M7,8 L7,14 M4,11 L10,11 M18,9 L18,10 M21,12 L21,13" /></Canvas></Viewbox>
                                                    <TextBlock Text="PS5" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding HomeModeDescription}" Foreground="#90A7C2" FontSize="11" Margin="3,10,0,10" />
                                <Expander Header="连接选项" Foreground="#91A4BC" FontSize="11" Margin="0,2,0,0">
                                    <StackPanel Margin="0,8,0,8">
                                        <Button Content="手动连接" IsEnabled="{Binding CanOperate}" HorizontalAlignment="Left" FontSize="12" Command="{Binding OpenManualConnectCommand}" Classes="home-action" ToolTip.Tip="自动连接失败时，手动选择设备" />

                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <WrapPanel>
                                <Button Content="{Binding CompactConnectText}" Command="{Binding ConnectPro2InputCommand}" IsEnabled="{Binding CompactCanConnect}" MinWidth="145" Classes="home-connect" />
                                <Button Content="停止 / 暂停重连" Command="{Binding CompactStopCommand}" IsEnabled="{Binding CompactCanStop}" Classes="home-action" />
                                <Button Content="按键配置 →" Command="{Binding OpenConfigurationCommand}" Classes="home-action" />
                                <Button Content="优化蓝牙 · Win10" IsEnabled="{Binding CanOperate}" Command="{Binding ToggleWindowsBluetoothPanelCommand}" Classes="home-action" IsVisible="{Binding ShowWin10BleHomeAction}" ToolTip.Tip="选择 7.5ms 参数并授权测试" />
                                <Button Content="取消操作" Command="{Binding CancelConnectionCommand}" Classes="home-action" IsVisible="{Binding Busy}" />
                            </WrapPanel>
                        <Border Background="#1B2B3D" BorderBrush="#35485F" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,4,4,0" IsVisible="{Binding ShowWin10BleHomePanel}">
                            <StackPanel IsEnabled="{Binding CanOperate}">
                                <TextBlock Text="Win10 蓝牙优化" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <TextBlock Text="{Binding Win10BleHomeHint}" Margin="0,0,0,8" Classes="caption" />
                                <WrapPanel>
                                    <ComboBox Width="145" ItemsSource="{Binding Win10BlePresetOptions}" SelectedItem="{Binding SelectedWin10BlePreset}" Margin="0,0,8,0" IsEnabled="{Binding CanConfigureWin10Stack}" DisplayMemberBinding="{Binding Title}" ToolTip.Tip="固定 7.5ms 优先；其他两组用于兼容尝试" />
                                    <Button Content="授权并测试" Margin="0,0,8,0" Padding="14,7" IsEnabled="{Binding CanConfigureWin10Stack}" Command="{Binding ConfigureBluetoothCommand}" ToolTip.Tip="{Binding Win10BlePresetSafetyNote}" />
                                    <Button Content="恢复原参数" Margin="0" Padding="14,7" Command="{Binding RestoreBluetoothCommand}" />
                                </WrapPanel>
                                <TextBlock Text="效果以真实输入为准；未提速时，可换预设或恢复原参数。" Margin="0,8,0,0" Classes="caption" />
                            </StackPanel>
                        </Border>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="{Binding HomeSessionSummary}" Foreground="#90A4BD" FontSize="11" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

</UserControl>
