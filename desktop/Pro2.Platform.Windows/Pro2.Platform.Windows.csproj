<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <AssemblyName>Pro2.Platform.Windows</AssemblyName>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../source/final-three-in-one/windows/v60_viiper_app/Y700Switch2V60Viiper.csproj"
                      AdditionalProperties="PureSoftwareRelease=true;EmbedUsbipInstaller=true;EnableWindowsTargeting=true" />
  </ItemGroup>
  <Target Name="PublishOriginalUacRuntimeManifest" AfterTargets="Publish">
    <PropertyGroup>
      <OriginalWindowsOutput>$(MSBuildThisFileDirectory)../../source/final-three-in-one/windows/v60_viiper_app/bin/$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)</OriginalWindowsOutput>
    </PropertyGroup>
    <Copy SourceFiles="$(OriginalWindowsOutput)/PRO2ControllerAssistant.deps.json" DestinationFolder="$(PublishDir)" />
    <Error Condition="!Exists('$(PublishDir)PRO2ControllerAssistant.exe')" Text="The original Windows UAC configuration host must be included in the native publication." />
  </Target>
</Project>
